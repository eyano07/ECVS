# ==========================================================================
# MODÈLE DE CONFIGURATION — CEV_AVI Gateway
# ==========================================================================
# Copiez ce fichier en ".env" (même dossier) et renseignez vos propres
# valeurs. Le fichier ".env" est ignoré par Git (voir .gitignore) : il ne
# doit JAMAIS être committé, car il contient des secrets.
#
#   cp server/.env.example server/.env
# ==========================================================================

# ---- Sécurité de la passerelle WebSocket ----
# Jeton partagé OBLIGATOIRE si WS_HOST=0.0.0.0 (accès réseau/externe).
# Fortement recommandé même en local. Générer avec : openssl rand -hex 32
GATEWAY_AUTH_TOKEN=

# Origines autorisées à se connecter, séparées par des virgules.
# Défaut : chrome-extension://* — les WebSocket n'étant PAS soumises au CORS,
# n'importe quel site web visité par l'utilisateur peut sinon ouvrir une
# connexion vers ws://127.0.0.1:8787 et injecter de faux événements, MÊME en
# loopback (GATEWAY_AUTH_TOKEN ne protège pas contre ce cas : l'attaque vient
# du propre navigateur de la victime, pas du réseau). Ne vider que si un
# client non-extension doit se connecter.
ALLOWED_ORIGINS=chrome-extension://*

# Hôte d'écoute du serveur WebSocket/HTTP.
#   127.0.0.1 (défaut) : accessible uniquement depuis cette machine.
#   0.0.0.0            : accessible depuis le réseau/l'extérieur — exige
#                        alors GATEWAY_AUTH_TOKEN.
WS_HOST=127.0.0.1

# Port d'écoute du serveur WebSocket/HTTP (doit correspondre à l'URL saisie
# dans le popup de l'extension).
WS_PORT=8787

# ---- Kafka : broker, topics, groupId & purge ----
# Adresse du broker Kafka (host:port).
KAFKA_BROKER=127.0.0.1:8686

# Topics utilisés (à ne changer que si le broker est partagé).
KAFKA_TOPIC=appointment-found
REGISTRY_TOPIC=applicant-registry

# groupId STABLE du consumer. Ne PAS lancer deux instances de passerelle avec
# le même groupId (architecture mono-instance).
KAFKA_CONSUMER_GROUP_ID=cev-avi-gateway

# Intervalle (ms) entre deux purges du topic appointment-found.
KAFKA_PURGE_INTERVAL_MS=30000

# ---- Notifications email (Gmail) ----
# Compte Gmail expéditeur.
GMAIL_USER=

# Mot de passe d'application Google (16 caractères, SANS espaces).
# PAS le mot de passe du compte. À créer sur :
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Destinataires par défaut de l'email "RDV réservé" (séparés par des virgules).
MAIL_RECIPIENTS=

# Destinataire(s) de l'alerte automatique « RDV trouvé » envoyée par le
# serveur lui-même (contient l'URL IP:Port du serveur).
APPOINTMENT_ALERT_RECIPIENTS=

# Délai minimum (ms) entre deux alertes "RDV trouvé" pour le même numéro
# internet, pour éviter une cascade d'emails (300000 = 5 min).
APPOINTMENT_ALERT_COOLDOWN_MS=300000

# Hôte public affiché dans l'alerte "RDV trouvé" (IP ou nom DNS).
# Laisser vide = détection automatique de la première IPv4 non-interne.
SERVER_PUBLIC_HOST=

# URL publique complète, si l'hôte seul ne suffit pas (prioritaire sur
# SERVER_PUBLIC_HOST). Exemple : ws://203.0.113.10:8787
SERVER_PUBLIC_URL=
